<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>MVC Test</title>
</head>
<body>
  <h1>Daftar Item</h1>
  <ul>
    <% items.forEach(item => { %>
      <li><%= item.name %></li>
    <% }) %>
  </ul>

  <form action="/items" method="POST">
    <input type="text" name="name" placeholder="Nama item" required>
    <button type="submit">Tambah</button>
  </form>
</body>
</html>
